# ==========================================================================
# .gitignore -- Neural Language Models for Biomedical Causal Inference
# ==========================================================================

# ---- Raw datasets -------------------------------------------------------
# The raw FAERS exports are ~460 MB and exceed GitHub's 100 MB per-file limit.
# They are not redistributed here; see README.md for how to obtain them.
data/**/*_dataset.csv
data/Analgesics-induced acute liver failure/
data/Tramadol-related mortalities/
*.zip
*.tar.gz

# ---- Model weights ------------------------------------------------------
# ~37 GB across 160 checkpoints. Never commit these.
outputs/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
model.json
pytorch_state_dict.pt

# ---- Cluster / run logs -------------------------------------------------
logs/
scratch/
slurm-*.out
*.out
*.err
run_logs/
*.rtf

# ---- Environments and caches --------------------------------------------
venv/
.venv/
env/venv/
.hf_cache/
.pip_cache/
.cache/
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# ---- OS / editor cruft --------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# ---- Credentials (never commit) -----------------------------------------
*.pem
*.key
id_rsa*
id_ed25519*
.ssh/
.env
secrets.*
